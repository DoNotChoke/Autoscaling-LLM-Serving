# Không commit key thật. Dùng serving/gateway/api-key.sh để cấp/thu hồi key:
#   ./serving/gateway/api-key.sh add <name>      # in key ra 1 lần
#   ./serving/gateway/api-key.sh revoke <name>
#   ./serving/gateway/api-key.sh list
# Định dạng: mỗi khoá là client-id (dùng cho rate limit và access log), giá trị là API key.
apiVersion: v1
kind: Secret
metadata:
  name: gateway-api-keys
  namespace: llm-serving
type: Opaque
stringData:
  nghia: change-me
  ratelimit-test: change-me
