# Không commit key thật. Cách tạo key ngẫu nhiên:
#   kubectl -n llm-serving create secret generic vllm-api-key --from-literal=key="$(openssl rand -hex 24)"
# Đọc lại key để gọi API:
#   kubectl -n llm-serving get secret vllm-api-key -o jsonpath='{.data.key}' | base64 -d
apiVersion: v1
kind: Secret
metadata:
  name: vllm-api-key
  namespace: llm-serving
type: Opaque
stringData:
  key: change-me
