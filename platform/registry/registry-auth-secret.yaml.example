# Không commit mật khẩu thật. Tạo Secret (htpasswd bcrypt cho registry, username/password cho client):
#   U=llm; P=$(openssl rand -hex 16)
#   H=$(docker run --rm --entrypoint htpasswd httpd:2.4-alpine -Bbn "$U" "$P")
#   kubectl -n registry create secret generic registry-auth \
#     --from-literal=htpasswd="$H" --from-literal=username="$U" --from-literal=password="$P"
# Client: docker login localhost:30500 (node-1), infra/node/registries.yaml cho containerd mọi node
apiVersion: v1
kind: Secret
metadata:
  name: registry-auth
  namespace: registry
stringData:
  htpasswd: "llm:$2y$05$..."
  username: llm
  password: "<mật khẩu>"
